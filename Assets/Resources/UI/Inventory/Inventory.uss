:root {
    visibility: visible;
    cursor: resource('UI/Assets/Modern Menu 1/Graphics/Cursors/Cursor 2 64px');
}

.none {
    display: none;
}

.hotbarContainer {
    flex-grow: 0;
    flex-shrink: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
}

.hotbar-slot {
    flex-grow: 1;
    width: 96px;
    height: 96px;
    max-width: 64px;
    max-height: 64px;
    background-image: resource('UI/Inventory/ItemDisable');
    cursor: resource('UI/Assets/Cursors/Cursor 2 64px');
    margin: 3px;
}

.hotbar-slot.selected {
    background-image: resource('UI/Inventory/ItemEnable');
    cursor: resource('UI/Assets/Cursors/Cursor 2 64px');
}

.slotIcon {
    width: 64px;
    height: 64px;
    align-self: center;
    justify-content: center;
    align-items: center;
    cursor: resource('UI/Assets/Cursors/Cursor 2 64px');
}

.inventoryElement {
    width: 96px;
    height: 96px;
    justify-content: center;
    align-items: center;
    border-left-color: rgb(48, 48, 48);
    border-right-color: rgb(48, 48, 48);
    border-top-color: rgb(48, 48, 48);
    border-bottom-color: rgb(48, 48, 48);
    background-color: rgb(9, 19, 21);
    cursor: resource('UI/Assets/Cursors/Cursor 2 64px');
    margin: 6px;
}

.slotBackground {
    background-image: resource('UI/Assets/UIDifferentFree03Wenrexa/PNG/Cell01');
    cursor: resource('UI/Assets/Cursors/Cursor 2 64px');
}

.slotBackground2 {
    background-image: resource('UI/Assets/1. Free Hologram Interface Wenrexa(1)/1. Free Hologram Interface Wenrexa/Card X3/Card X5');
    cursor: resource('UI/Assets/Cursors/Cursor 2 64px');
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.62);
}

.slotQuantity {
    position: absolute;
    bottom: 2px;
    right: 2px;
    font-size: 20px;
    color: white;
    background-color: rgba(0, 0, 0, 0.7);
    padding: 2px 4px;
    border-radius: 3px;
    cursor: resource('UI/Assets/Cursors/Cursor 1 64px');
}

.craftingContainer {
    flex-grow: 1;
    flex-shrink: 1;
    width: 59%;
    height: 76%;
    max-width: 100%;
    flex-basis: auto;
    background-image: resource('UI/Assets/1. Free Hologram Interface Wenrexa(1)/1. Free Hologram Interface Wenrexa/Card X1/Card X1');
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.4);
    visibility: visible;
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-self: flex-start;
    justify-content: center;
    background-size: 115% 115%;
    max-height: 77%;
    align-content: auto;
    flex-direction: row;
    align-items: stretch;
    overflow: hidden;
    cursor: resource('UI/Assets/Modern Menu 1/Graphics/Cursors/Cursor 2 64px');
}

.crafting-icon {
    width: 96px;
    height: 96px;
    min-width: 96px;
    min-height: 96px;
    display: flex;
    flex-direction: row;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.59);
    cursor: resource('UI/Assets/Cursors/Cursor 1 64px');
}

.crafting-icon > Image {
    width: 64px;
    height: 64px;
    min-width: 64px;
    min-height: 64px;
}

.recipeIcon {
    width: 80px;
    height: 120px;
    max-width: 120px;
    max-height: 80px;
    cursor: resource('UI/Assets/Cursors/Cursor 1 64px');
}

.recipeCont {
    width: 128px;
    height: 128px;
    max-width: 128px;
    max-height: 128px;
    align-self: center;
    justify-content: center;
    align-items: center;
    cursor: resource('UI/Assets/Cursors/Cursor 1 64px');
}

.ingredient-label {
    font-size: 20px;
    color: white;
    cursor: resource('UI/Assets/Cursors/Cursor 1 64px');
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.5);
    white-space: normal;
    max-height: 40px;
}

.ingredient-available {
    color: rgba(0, 255, 0, 0.7);
    text-shadow: 0 0 2px rgba(0, 0, 0, 0.7);
}

.ingredient-missing {
    text-shadow: 0 0 2px rgba(0, 0, 0, 0.7);
    color: rgba(255, 0, 0, 0.7);
}

.ConfirmCraft {
    width: 128px;
    height: 64px;
    background-color: rgb(76, 175, 80);
    color: white;
    padding: 10px 20px;
    border-radius: 5px;
    margin-top: 20px;
    align-self: center;
    transition: all 0.2s ease;
    cursor: resource('UI/Assets/Cursors/Cursor 1 64px');
}

.ConfirmCraft:hover {
    background-color: rgb(69, 160, 73);
}

.unity-base-slider__drag-container {
    display: none;
    overflow: hidden;
}

.unity-low-button {
    display: none;
    overflow: hidden;
}

.unity-high-button {
    display: none;
}

.unity-slider {
    display: none;
    overflow: hidden;
}

.unity-repeat-button {
    display: none;
}

.recipesList .unity-scroll-view__vertical-scroller {
    display: none;
    cursor: resource('UI/Assets/Modern Menu 1/Graphics/Cursors/Cursor 2 64px');
}

.recipesList .unity-scroll-view__horizontal-scroller {
    display: none;
    cursor: resource('UI/Assets/Modern Menu 1/Graphics/Cursors/Cursor 2 64px');
}

.recipesList {
    align-self: center;
    cursor: resource('UI/Assets/Modern Menu 1/Graphics/Cursors/Cursor 2 64px');
    max-width: 33%;
    min-width: 33%;
    max-height: 95%;
    min-height: 95%;
}

#unity-content-container {
    cursor: resource('UI/Assets/Modern Menu 1/Graphics/Cursors/Cursor 2 64px');
}

#1 > #VisualElement > #crafting-container > #recipesList > .unity-collection-view__scroll-view > #unity-content-and-vertical-scroll-container {
    cursor: resource('UI/Assets/Modern Menu 1/Graphics/Cursors/Cursor 2 64px');
}

#1 > #VisualElement > #crafting-container > #recipesList > .unity-collection-view__scroll-view {
    cursor: resource('UI/Assets/Modern Menu 1/Graphics/Cursors/Cursor 2 64px');
}

.recipesCraftingContainer {
    max-height: 85%;
    max-width: 66%;
    min-height: 85%;
    min-width: 66%;
    align-items: flex-start;
    flex-direction: column;
    justify-content: flex-start;
    align-self: center;
}

.ghostIcon {
    overflow: visible;
    visibility: visible;
    position: absolute;
    width: 64px;
    height: 64px;
    top: auto;
    left: auto;
    min-width: 64px;
    min-height: 64px;
    max-height: 64px;
    max-width: 64px;
    background-image: none;
    cursor: resource('UI/Assets/Cursors/Cursor 2 64px');
}
