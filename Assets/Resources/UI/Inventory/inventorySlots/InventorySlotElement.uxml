<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="inventorySlot" class="inventorySlot" style="width: 32px; height: 32px; max-height: 32px; max-width: 32px; min-height: 32px; min-width: 32px; background-image: resource(&apos;UI/Assets/UIDifferentFree03Wenrexa/PNG/Cell01&apos;); margin-top: 19px; margin-right: 19px; margin-bottom: 19px; margin-left: 19px;">
        <ui:VisualElement name="cell" style="flex-grow: 1; background-image: resource(&apos;UI/Inventory/frame&apos;);">
            <ui:VisualElement name="icon" style="flex-grow: 1; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; background-image: none; margin-top: 7px; margin-right: 7px; margin-bottom: 7px; margin-left: 7px;">
                <ui:Label name="quantity" triple-click-selects-line="true" enabled="true" enable-rich-text="true" style="height: 47px; width: 49px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 14%; align-items: auto; -unity-font-style: normal; color: rgb(255, 255, 255); -unity-text-align: lower-right; justify-content: space-around; align-self: flex-end; align-content: auto; min-height: auto; max-width: initial; max-height: initial;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
