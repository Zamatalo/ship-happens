:root {
}

.slot {
    width: 64px;
    height: 64px;
    background-color: rgb(85, 85, 85);
    position: relative;
    margin: 2%;
    padding: 2;
}

#icon {
    width: 100%;
    height: 100%;
}

#quantity {
    position: absolute;
    bottom: 0;
    right: 0;
    font-size: 10px;
    color: white;
    background-color: rgba(0, 0, 0, 0.5);
    padding: 2px;
}
